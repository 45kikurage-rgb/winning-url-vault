{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "winning-url-vault",
  "main": "src/index.js",
  "compatibility_date": "2026-09-22",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [
    { "binding": "DB", "database_name": "winning-url-vault", "database_id": "REPLACE_AFTER_D1_CREATE" }
  ]
}
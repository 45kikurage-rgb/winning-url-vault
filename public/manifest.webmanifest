{
  "name": "Aruno-Ticket",
  "short_name": "Aruno-Ticket",
  "description": "当選URL・コードを共有から直接受け付けて管理します。",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#020711",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icon-any-192.png?v=aruno-ticket-20261107",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-any-512.png?v=aruno-ticket-20261107",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png?v=aruno-ticket-20261107",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "launch_handler": {
    "client_mode": "navigate-existing"
  }
}
